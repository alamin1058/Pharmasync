# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PHARMASYNC_ADMIN_PASSWORD: Optional Super Admin passcode configured via Settings -> Secrets.
# When unset, PharmaSync presents a one-time First-Run Admin Setup screen.
PHARMASYNC_ADMIN_PASSWORD=

# PORT: Server listening port (3000 in AI Studio preview).
PORT=3000
